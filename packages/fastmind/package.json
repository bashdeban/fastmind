{
  "name": "fastmind",
  "displayName": "Fastmind: AI-driven mind mapping.",
  "version": "0.1.3",
  "description": "Fastmind is an open-source VS Code extension that integrates AI-driven mind mapping into your workflow, using large language models to generate context-aware subtopics and improve ideation directly inside the IDE.",
  "publisher": "bashdeban",
  "main": "dist/extension.js",
  "icon": "fastmind.png",
  "markdown": "github",
  "preview": false,
  "qna": "marketplace",
  "scripts": {
    "build": "webpack --config webpack.extension.js --mode production",
    "build:extension": "webpack --config webpack.extension.js --mode production",
    "build:watch": "webpack --config webpack.extension.js --mode production --watch",
    "clean": "rimraf dist",
    "dev": "concurrently \"npm run build:watch\"",
    "test": "jest",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "type-check": "tsc --noEmit",
    "package": "vsce package",
    "package:preview": "vsce package --out fastmind.vsix",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-uri": "^3.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vscode/vsce": "^3.7.1",
    "concurrently": "^9.1.0",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^9.38.0",
    "jest": "^30.2.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "vscode": "^1.106.0"
  },
  "activationEvents": [
    "onLanguage:fastmind",
    "onCustomEditor:fastmind.viewer"
  ],
  "categories": [
    "Visualization",
    "Notebooks",
    "Education",
    "Other"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fastmind",
        "extensions": [
          ".fastmind"
        ],
        "aliases": [
          "FastMind"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "fastmind.viewer",
        "displayName": "WiseMapping FastMind Editor",
        "selector": [
          {
            "filenamePattern": "*.fastmind"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "FastMind",
      "properties": {
        "autoSave.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable auto-save for FastMind documents"
        },
        "autoSave.delay": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 10000,
          "description": "Auto-save delay in milliseconds"
        },
        "autoSave.onFocusChange": {
          "type": "boolean",
          "default": false,
          "description": "Auto-save when focus changes"
        },
        "autoSave.onWindowChange": {
          "type": "boolean",
          "default": false,
          "description": "Auto-save when window changes"
        },
        "fastmind.language.locale": {
          "type": "string",
          "enum": [
            "en",
            "zh-CN",
            "zh-Hant",
            "ja",
            "fr",
            "de",
            "es",
            "it",
            "pt",
            "ru"
          ],
          "default": "en",
          "description": "Language locale for FastMind editor"
        }
      }
    }
  },
  "capabilities": {
    "virtualWorkspaces": true
  },
  "license": "WiseMapping Public License 1.0",
  "author": {
    "name": "bashdeban",
    "email": "bashdeban@gmail.com"
  },
  "keywords": [
    "wisemapping",
    "mindmapping",
    "mind map",
    "fastmind",
    "AI Generator",
    "AI Explainer",
    "AI",
    "LLM",
    "editor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bashdeban/fastmind"
  },
  "bugs": {
    "url": "https://github.com/bashdeban/fastmind/issues"
  },
  "homepage": "https://github.com/bashdeban/fastmind"
}